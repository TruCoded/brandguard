# Database: SQLite by default (zero setup). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/brandguard
DATABASE_URL=sqlite:///./brandguard.db

# Optional: grounded AI rewrites (rules-only mode works without this)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: real "Sign in with Instagram" (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback
